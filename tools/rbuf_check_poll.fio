[global]
ioengine=libaio
direct=1
filename=${DEV}
group_reporting=1
lat_percentiles=1
percentile_list=50:99:99.9

[prefill]
rw=write
bs=128k
iodepth=32
offset=0
size=8g

[ro]
ioengine=io_uring
hipri=1
stonewall
rw=randread
bs=4k
iodepth=${RQD}
offset=0
size=8g
time_based
runtime=${ROT}
write_lat_log=${TAG}_ro
log_offset=1

[reader]
ioengine=io_uring
hipri=1
stonewall
rw=randread
bs=4k
iodepth=${RQD}
offset=0
size=8g
startdelay=2
time_based
runtime=3600
write_lat_log=${TAG}_reader
log_offset=1

[writer]
rw=randwrite
bs=16k
iodepth=32
offset=8g
size=16g
exitall=1
write_iops_log=${TAG}_writer
log_avg_msec=1000
